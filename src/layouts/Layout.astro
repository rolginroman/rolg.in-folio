---
import "../styles/base.scss";
import doto from "../styles/fonts/doto-latin-var.woff2";
import grotesk from "../styles/fonts/space-grotesk-latin-var.woff2";
import mono400 from "../styles/fonts/space-mono-latin-400.woff2";
import mono700 from "../styles/fonts/space-mono-latin-700.woff2";
import { SEO } from "astro-seo";
import { identity, seo } from "../data/profile";
import Rail from "@/signal/Rail.astro";
import ActionBar from "@/signal/ActionBar.astro";

export interface Props {
  title?: string;
  description?: string;
}

const baseUrl = import.meta.env.BASE_URL;
const fonts = [doto, grotesk, mono400, mono700];
const { title = `${identity.fullName} — ${identity.role}`, description = seo.description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-critters-container>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f2f0" media="(prefers-color-scheme: light)" />
    <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: `${baseUrl}og-image.png`,
        },
      }}
      twitter={{
        creator: seo.twitterCreator,
        title,
        description: seo.twitterDescription,
        image: `${baseUrl}og-image.png`,
        imageAlt: seo.imageAlt,
      }}
      extend={{
        link: [{ rel: "icon", href: `${baseUrl}favicon.svg`, type: "image/svg+xml" }],
      }}
    />
    {
      fonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }
  </head>
  <body>
    <a class="sg-skip" href="#main">Skip to content</a>
    <div class="sg-rules" aria-hidden="true">
      <div>
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="sg-page">
      <Rail />
      <main id="main">
        <slot />
      </main>
    </div>
    <ActionBar />
  </body>
</html>
