---
import { tech, techGroups } from "../../data/profile";
import SectionHead from "./SectionHead.astro";
import InlineIcon from "../InlineIcon.astro";

/**
 * The AI-engineering group leads: it is the part of the stack a recruiter
 * cannot infer from the rest of the page, and the only one whose entries
 * carry their own evidence. Data order is untouched; this is display order.
 */
const LEAD_LABEL = "AI engineering";
const lead = techGroups.filter((group) => group.label === LEAD_LABEL);
const rest = techGroups.filter((group) => group.label !== LEAD_LABEL);
const ordered = [...lead, ...rest];
---

<section id="stack" class="stack" aria-labelledby="stack-title">
  <div class="sg-wrap">
    <SectionHead id="stack-title" title="Stack" meta={`${tech.length} technologies`} />

    {
      ordered.map((group, index) => {
        const noted = group.items.filter((item) => item.note);
        return index === 0 ? (
          <div class="row lead">
            <h3 class="sg-label">{group.label}</h3>
            <ul class="primary">
              {group.items.map((item) => (
                <li>
                  <span class="entry">
                    <InlineIcon name={item.monoIconName} class="mark" aria-hidden="true" focusable="false" />
                    {item.name}
                  </span>
                  {item.note && <span class="note">{item.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="row">
            <h3 class="sg-label">{group.label}</h3>
            <div class="col">
              <ul class="chips">
                {group.items.map((item) => (
                  <li>
                    <InlineIcon name={item.monoIconName} class="mark" aria-hidden="true" focusable="false" />
                    {item.name}
                  </li>
                ))}
              </ul>
              {noted.length > 0 && (
                <ul class="notes">
                  {noted.map((item) => (
                    <li>
                      <span class="sg-label">{item.name}</span>
                      <span class="note">{item.note}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style lang="scss">
  .stack {
    padding-block: var(--section-gap) 0;
    scroll-margin-top: 3rem;
  }

  .row {
    display: grid;
    gap: 0.875rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .row:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  h3 {
    padding-top: 0.3125rem;
  }

  /* lead group: one line per entry, with its reason where there is one */
  .primary {
    display: grid;
    gap: 1.125rem;
  }

  .primary > li {
    display: grid;
    gap: 0.25rem;
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--t-title);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-0);
  }

  .note {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.55;
    max-width: 62ch;
  }

  .col {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: var(--t-cap);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .mark {
    display: block;
    flex: none;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
  }

  .chips .mark {
    width: 0.875em;
    height: 0.875em;
  }

  .entry .mark {
    color: var(--ink-1);
  }

  .notes {
    display: grid;
    gap: 0.5rem;
  }

  .notes li {
    display: grid;
    gap: 0.125rem;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      padding-block: 1.75rem;
    }

    .row > h3 {
      padding-right: 1.5rem;
    }

    .row > ul,
    .row > .col {
      grid-column: 2 / -1;
    }

    /* note text starts on the next page rule, like every other column */
    .notes li {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      align-items: baseline;
    }

    .notes li .sg-label {
      padding-right: 1.5rem;
    }

    .notes li .note {
      grid-column: 2 / -1;
      padding-right: 2rem;
    }
  }
</style>
