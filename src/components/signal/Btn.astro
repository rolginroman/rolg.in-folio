---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  icon?: IconName;
  external?: boolean;
  ariaLabel?: string;
  /** Shown below 48rem when the full label will not fit a crowded bar. */
  labelShort?: string;
  class?: string;
}

const {
  href,
  label,
  variant = "secondary",
  icon,
  external = false,
  ariaLabel,
  labelShort,
  class: className,
} = Astro.props;
---

<a
  class:list={["btn", variant, labelShort && "has-short", className]}
  href={href}
  aria-label={ariaLabel}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span class="full">{label}</span>
  {labelShort && <span class="short">{labelShort}</span>}
  {icon && <Icon name={icon} size={16} />}
</a>

<style lang="scss">
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.6875rem 1.25rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--ink-1);
    background: transparent;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease),
      background-color 0.18s var(--ease);
  }

  .btn:hover {
    border-color: var(--ink-1);
    color: var(--ink-0);
  }

  .primary {
    background: var(--ink-0);
    border-color: var(--ink-0);
    color: var(--bg);
    font-weight: 700;
  }

  .primary:hover {
    background: var(--ink-1);
    border-color: var(--ink-1);
    color: var(--bg);
  }

  .short {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .has-short .full {
      display: none;
    }
    .has-short .short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
