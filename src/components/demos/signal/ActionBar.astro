---
import { links, identity } from "../../../data/profile";
import Btn from "./Btn.astro";
---

<div class="bar">
  <div class="sg-wrap inner">
    <span class="sg-label who">{identity.fullName}</span>
    <div class="acts">
      <Btn href={`mailto:${links.mail}`} label="E-mail" icon="mail" ariaLabel="Contact me with e-mail" />
      <Btn href={links.telegram} label="Telegram" icon="telegram" ariaLabel="Contact me with Telegram" external />
      <Btn
        href={links.cv}
        label="Download CV"
        labelShort="CV"
        variant="primary"
        icon="arrow-down"
        external
        class="cv"
      />
    </div>
  </div>
</div>

<style lang="scss">
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: var(--bg);
    border-top: 1px solid var(--rule-strong);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    min-height: var(--bar-h);
    padding-block: 0.4375rem;
  }

  .who {
    display: none;
    margin-right: auto;
    color: var(--ink-3);
  }

  .acts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .acts :global(.btn) {
    flex: 1;
    min-width: 0;
    min-height: 2.625rem;
    padding-inline: 0.75rem;
  }

  /* below 23.5rem the two secondary routes drop to icon only; aria-label carries the name */
  @media (max-width: 23.5rem) {
    .acts :global(.btn:not(.cv) span) {
      display: none;
    }

    .acts :global(.btn:not(.cv)) {
      flex: 0 0 auto;
      padding-inline: 0.875rem;
    }
  }

  .acts :global(.cv) {
    flex: 1.35;
  }

  @media (min-width: 48rem) {
    .who {
      display: inline;
    }

    .acts {
      flex: none;
    }

    .acts :global(.btn) {
      flex: none;
      padding-inline: 1.25rem;
    }
  }
</style>
