---
interface Props {
  id: string;
  title: string;
  /** Right-hand readout: a real count or unit, never decoration. */
  meta: string;
}

const { id, title, meta } = Astro.props;
---

<div class="head">
  <h2 id={id}>{title}</h2>
  <span class="rule" aria-hidden="true"></span>
  <span class="meta">{meta}</span>
</div>

<style lang="scss">
  .head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  h2 {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-1);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .meta {
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
</style>
