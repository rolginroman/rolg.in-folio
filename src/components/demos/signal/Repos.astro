---
import { projects, ndaNote } from "../../../data/profile";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import Btn from "./Btn.astro";

const pad = (value: number) => String(value).padStart(2, "0");

// Half this list is private work, so a row is a link only when there is
// something to open. A linkless row keeps the same grid, mark and copy and
// drops the affordance: no out-arrow, no hover state, no anchor at all.
const linkAttrs = (link?: string) => (link ? { href: link, target: "_blank", rel: "noopener noreferrer" } : {});
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="sg-wrap">
    <SectionHead id="work-title" title="Work" meta={`${projects.length} entries`} />

    <ul class="list">
      {
        projects.map((project, index) => {
          const Row = project.link ? "a" : "div";

          return (
            <li>
              <Row class:list={["row", index === 0 && "lead"]} {...linkAttrs(project.link)}>
                <span class="mark" aria-hidden="true">
                  {project.mark}
                </span>

                <span class="body">
                  <span class="name">
                    {project.name}
                    {project.link && <Icon name="arrow-ne" size={18} class="cue" />}
                  </span>
                  <span class="desc">{project.description}</span>
                  {project.detail && <span class="detail">{project.detail}</span>}
                  <span class="outcome">{project.outcome}</span>
                  <span class="tags sg-label">{project.tags.join(" · ")}</span>
                </span>

                <span class="meta">
                  <span class="sg-value">{project.language}</span>
                  <span class="sg-label">
                    {project.year} · {project.kind === "work" ? "Contributor" : "Author"}
                  </span>
                  {project.kind === "own" && project.stars ? (
                    <span class="sg-label">Stars {pad(project.stars)}</span>
                  ) : null}
                </span>
              </Row>
            </li>
          );
        })
      }
    </ul>

    <div class="nda">
      <p>
        <strong>{ndaNote.lead}</strong>
        {" "}{ndaNote.body}
      </p>
      <Btn href={ndaNote.cvLink} label="Download CV" icon="arrow-down" external />
    </div>
  </div>
</section>

<style lang="scss">
  .work {
    padding-block: var(--section-gap) 0;
    scroll-margin-top: 3rem;
  }

  .list {
    border-top: 1px solid var(--rule);
  }

  .list li {
    border-bottom: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.75rem;
    padding: 1.25rem 0;
    text-decoration: none;
    transition: background-color 0.18s var(--ease);
  }

  .mark {
    grid-column: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .body {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    min-width: 0;
  }

  .name {
    display: block;
    font-size: var(--t-title);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-0);
    overflow-wrap: anywhere;
  }

  .lead .name {
    font-size: clamp(1.4375rem, 2.9vw, 2.125rem);
  }

  .cue {
    display: inline-block;
    vertical-align: -0.1em;
    margin-left: 0.45rem;
    color: var(--ink-3);
    transition: color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .desc {
    color: var(--ink-1);
    font-size: var(--t-sm);
  }

  .lead .desc {
    color: var(--ink-0);
    font-size: var(--t-body);
  }

  .detail {
    max-width: 62ch;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.6;
  }

  .outcome {
    max-width: 62ch;
    margin-top: 0.25rem;
    color: var(--ink-1);
    font-size: var(--t-sm);
    line-height: 1.6;
  }

  .tags {
    padding-top: 0.125rem;
  }

  .meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 1rem;
  }

  /* Only the rows that are links react to the pointer. A linkless row that lit
     up on hover would be promising something it cannot deliver. */
  a.row:hover {
    background: var(--surface);
  }

  a.row:hover .cue {
    color: var(--ink-0);
    transform: translate(2px, -2px);
  }

  a.row:hover .mark {
    border-color: var(--ink-0);
    color: var(--ink-0);
  }

  @media (min-width: 48rem) {
    .lead .detail {
      font-size: var(--t-body);
    }

    .lead .outcome {
      font-size: var(--t-body);
    }

    .row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 0;
      padding: 1.75rem 0;
    }

    .mark {
      grid-column: 1;
      grid-row: 1;
    }

    .body {
      grid-column: 1 / 4;
      grid-row: 1;
      padding-left: 3.5rem;
      padding-right: 2rem;
    }

    .meta {
      grid-column: 4;
      grid-row: 1;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.4375rem;
      text-align: right;
    }
  }

  .nda {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    padding-top: 2.25rem;
    max-width: 58ch;
  }

  .nda p {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.6;
  }

  .nda strong {
    color: var(--ink-1);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .cue,
    .mark {
      transition: none;
    }

    a.row:hover .cue {
      transform: none;
    }
  }
</style>
