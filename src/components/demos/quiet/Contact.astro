---
import { socials, links, identity } from "../../../data/profile";
import Action from "./Action.astro";
import InlineIcon from "../../InlineIcon.astro";
import { emailContact as email, telegramContact as telegram } from "./contacts";
---

<div class="contact">
  <p class="line">Write to me, or take the CV first. Either works.</p>

  <div class="actions">
    <Action href={links.cv} variant="solid" icon="mdi:tray-arrow-down">Download CV</Action>
    <Action href={email.href} icon="mdi:email-outline">{email.short}</Action>
    <Action href={telegram.href} icon="mdi:telegram">{telegram.short}</Action>
  </div>

  <ul class="socials">
    {
      socials.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            <InlineIcon name={social.iconName} class="mark" />
            {social.short}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="sig q-num">@{identity.handle} &middot; {identity.domain}</p>
</div>

<style lang="scss">
  .line {
    font-size: var(--t-lead);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--track-lead);
    color: var(--ink);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--u5);
    row-gap: var(--u2);
    margin-top: var(--u5);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--u5);
    margin-top: var(--u6);
    padding-top: var(--u5);
    border-top: 1px solid var(--hair);
    font-size: var(--t-small);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink-3);
    text-decoration-line: none;
    transition: color var(--fast) var(--ease-out);
  }

  .mark {
    font-size: 1.05em;
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .socials a:hover {
      color: var(--ink);
    }
  }

  .sig {
    margin-top: var(--u6);
    font-size: var(--t-micro);
    letter-spacing: var(--track-label);
    color: var(--ink-3);
  }
</style>
