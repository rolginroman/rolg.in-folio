---
import { identity, careerStartYear } from "../../../data/profile";

const rows = [
  { label: "Role", value: identity.role },
  { label: "Based", value: identity.location },
  { label: "Since", value: String(careerStartYear), numeric: true },
  { label: "Handle", value: identity.handle },
];
---

<dl class="facts">
  <div class="facts__head">In brief</div>
  {
    rows.map((row) => (
      <div class="facts__row">
        <dt class="facts__label">{row.label}</dt>
        <dd class={`facts__value${row.numeric ? " facts__value--num" : ""}`}>{row.value}</dd>
      </div>
    ))
  }
</dl>

<style lang="scss">
  @use "demos/broadsheet/tokens" as *;

  .facts {
    background: $paper-deep;
    border: 1px solid $rule;
    border-top: 2px solid $ink;
    padding: 0.85rem 1rem 1rem;
  }

  .facts__head {
    @include furniture(0.625rem);
    letter-spacing: 0.2em;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid $rule;
  }

  .facts__row {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(201, 192, 173, 0.6);

    &:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
  }

  .facts__label {
    @include furniture(0.5625rem);
    color: $ink-soft;
    letter-spacing: 0.14em;
  }

  .facts__value {
    @include optical(16, 400);
    font-size: 0.9375rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .facts__value--num {
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.01em;
  }
</style>
