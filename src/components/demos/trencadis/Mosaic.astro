---
// The mosaic wall. Every technology is a shard; the four glazes are the four
// groups, so the colour carries the grouping instead of a legend. The tiling is
// hand-set — each tile's column and row span is data, not a repeat().
//
// Two rules give the wall its ranking. A tile with a `note` is a bigger shard,
// because it has something to say; and AI engineering, which is three-fifths
// notes, takes the ochre lot — the brightest glaze against the grout.
import InlineIcon from "../../InlineIcon.astro";
import { techGroups } from "../../../data/profile";
import Shard from "./Shard.astro";
import type { Tone } from "./tones";

/** Column start / span and row start / span. */
type Cell = [number, number, number, number];

/** Placement is looked up by name, so an entry added to the data still renders. */
const wide: Record<string, Cell> = {
  "Languages & frameworks": [1, 12, 1, 1],
  TypeScript: [1, 4, 2, 2],
  JavaScript: [5, 4, 2, 2],
  Angular: [9, 4, 2, 2],
  RxJS: [1, 3, 4, 2],
  React: [4, 3, 4, 2],
  "React Router": [7, 3, 4, 2],
  "Next.js": [10, 3, 4, 2],
  Astro: [1, 6, 6, 2],
  SCSS: [7, 6, 6, 2],

  "AI engineering": [1, 12, 8, 1],
  "Claude Code": [1, 4, 9, 4],
  "Agent skills": [5, 4, 9, 4],
  OpenCode: [9, 4, 9, 4],
  Codex: [1, 6, 13, 2],
  Cursor: [7, 6, 13, 2],

  "Platform & data": [1, 12, 15, 1],
  "Node.js": [1, 4, 16, 2],
  NestJS: [5, 4, 16, 2],
  Prisma: [9, 4, 16, 2],
  PostgreSQL: [1, 6, 18, 2],
  Docker: [7, 6, 18, 2],
  "Cloudflare Workers": [1, 6, 20, 4],
  Solana: [7, 6, 20, 4],

  "Build, release & quality": [1, 12, 24, 1],
  Nx: [1, 4, 25, 2],
  pnpm: [5, 4, 25, 2],
  Vitest: [9, 4, 25, 2],
  Jest: [1, 3, 27, 2],
  Storybook: [4, 3, 27, 2],
  Sentry: [7, 3, 27, 2],
  Git: [10, 3, 27, 2],
  "GitHub Actions": [1, 12, 29, 3],
};

const narrow: Record<string, Cell> = {
  "Languages & frameworks": [1, 4, 1, 1],
  TypeScript: [1, 2, 2, 2],
  JavaScript: [3, 2, 2, 2],
  Angular: [1, 2, 4, 2],
  RxJS: [3, 2, 4, 2],
  React: [1, 2, 6, 2],
  "React Router": [3, 2, 6, 2],
  "Next.js": [1, 2, 8, 2],
  Astro: [3, 2, 8, 2],
  SCSS: [1, 4, 10, 2],

  "AI engineering": [1, 4, 12, 1],
  "Claude Code": [1, 4, 13, 3],
  "Agent skills": [1, 4, 16, 3],
  OpenCode: [1, 4, 19, 3],
  Codex: [1, 2, 22, 2],
  Cursor: [3, 2, 22, 2],

  "Platform & data": [1, 4, 24, 1],
  "Node.js": [1, 2, 25, 2],
  NestJS: [3, 2, 25, 2],
  Prisma: [1, 2, 27, 2],
  PostgreSQL: [3, 2, 27, 2],
  Docker: [1, 4, 29, 2],
  "Cloudflare Workers": [1, 4, 31, 3],
  Solana: [1, 4, 34, 3],

  "Build, release & quality": [1, 4, 37, 1],
  Nx: [1, 2, 38, 2],
  pnpm: [3, 2, 38, 2],
  Vitest: [1, 2, 40, 2],
  Jest: [3, 2, 40, 2],
  Storybook: [1, 2, 42, 2],
  Sentry: [3, 2, 42, 2],
  Git: [1, 4, 44, 2],
  "GitHub Actions": [1, 4, 46, 3],
};

/** One glaze lot per group, in group order. Colour is the grouping. */
const lots: Tone[] = ["cobalt", "ochre", "verd", "terra"];

interface Tile {
  name: string;
  iconName?: string;
  note?: string;
  tone: Tone;
  label: boolean;
}

const tiles: Tile[] = techGroups.flatMap((group, g) => [
  { name: group.label, tone: "bone" as Tone, label: true },
  ...group.items.map((item) => ({
    name: item.name,
    // Single-path marks take the tile's own ink, so every glaze keeps its mark
    // legible without a patch of bone underneath a full-colour logo.
    iconName: item.monoIconName,
    note: item.note,
    tone: lots[g % lots.length] as Tone,
    label: false,
  })),
]);

/** A tile with no entry in the maps simply auto-flows rather than vanishing. */
const place = (name: string) => {
  const w = wide[name];
  const n = narrow[name];
  const vars = [
    w && `--c:${w[0]};--cs:${w[1]};--r:${w[2]};--rs:${w[3]}`,
    n && `--mc:${n[0]};--mcs:${n[1]};--mr:${n[2]};--mrs:${n[3]}`,
  ].filter(Boolean);
  return vars.join(";");
};

const cls = (t: Tile) =>
  ["tile", t.label ? "tile--label" : "", t.note ? "tile--noted" : "", place(t.name) ? "" : "tile--loose"]
    .filter(Boolean)
    .join(" ");

const noted = tiles.filter((t) => t.note).length;
---

<section class="stack" id="stack" aria-labelledby="stack-title">
  <div class="stack__head">
    <h2 class="stack__title" id="stack-title">Technology</h2>
    <p class="stack__lead">
      {tiles.length - techGroups.length} tools, set in {techGroups.length} glazes — one glaze per group. The {noted} larger
      shards carry the reason they are here.
    </p>
  </div>

  <ul class="mosaic" data-mosaic>
    {
      tiles.map((t, i) => (
        <Shard
          as="li"
          tone={t.tone}
          cut={t.label ? 2 : ((i * 7) % 6) + 1}
          lot={i}
          class={cls(t)}
          style={`${place(t.name)};--i:${i}`}
        >
          {
            t.label ? (
              <h3 class="tile__group">{t.name}</h3>
            ) : (
              <>
                <span class="tile__head">
                  <InlineIcon name={t.iconName!} />
                  <span class="tile__name">{t.name}</span>
                </span>
                {t.note && <span class="tile__note">{t.note}</span>}
              </>
            )
          }
        </Shard>
      ))
    }
  </ul>
</section>

<style lang="scss">
  @use "demos/trencadis/world" as w;

  .stack__head {
    max-width: 52ch;
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }

  .stack__title {
    font-family: var(--tc-display);
    font-weight: 400;
    font-size: clamp(2rem, 6vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--tc-bone);
  }

  .stack__lead {
    margin: 0.7rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--tc-bone-dim);
  }

  .mosaic {
    --u: clamp(1.4rem, 5.6vw, 1.85rem);
    --grout: 4px;

    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    // The unit is a floor, not a cap: a row grows if a note needs the line, so
    // no tile can ever clip its own reason for being large.
    grid-auto-rows: minmax(var(--u), auto);
    gap: var(--grout);

    @include w.wall {
      --u: clamp(1.15rem, 1.7vw, 1.6rem);
      --grout: 5px;

      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .tile {
    --cut-sm: 0.75rem;
    --cut-lg: 1.35rem;

    grid-column: var(--mc) / span var(--mcs);
    grid-row: var(--mr) / span var(--mrs);
    min-width: 0;

    @include w.wall {
      grid-column: var(--c) / span var(--cs);
      grid-row: var(--r) / span var(--rs);
    }

    :global(.shard__body) {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
      padding: 0.35rem clamp(0.55rem, 1.6vw, 0.9rem);
      min-width: 0;
    }
  }

  // A tile the maps do not place flows into the wall on its own rather than
  // stacking on top of tile one.
  .tile--loose {
    grid-column: auto / span 2;
    grid-row: auto / span 2;

    @include w.wall {
      grid-column: auto / span 3;
      grid-row: auto / span 2;
    }
  }

  .tile__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  // Bound every svg in the head, whatever its class and wherever it came from.
  // A mark free to size itself can shove a whole band of the tiling off its
  // grid, and a cell in a mosaic should never be at the mercy of its contents.
  .tile__head :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: currentColor;
    opacity: 0.92;
  }

  .tile__name {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1.15;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  // The shards that earn their size: the note is the whole reason they are big.
  .tile--noted {
    --cut-sm: 0.95rem;
    --cut-lg: 1.6rem;
    --sheen: 0.4;

    :global(.shard__body) {
      justify-content: flex-start;
      gap: 0.4rem;
      padding-block: 0.7rem;
    }

    .tile__name {
      font-family: var(--tc-display);
      font-weight: 400;
      font-size: clamp(1.05rem, 2.6vw, 1.3rem);
      letter-spacing: -0.012em;
    }

    .tile__head :global(svg) {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  .tile__note {
    font-size: 0.76rem;
    line-height: 1.45;
    max-width: 68ch;
    opacity: 0.88;
  }

  // Group labels are the shortest pieces in the wall — one row tall — so they
  // take shallow breaks that a full-depth cut would swallow.
  .tile--label {
    --cut-sm: 0.4rem;
    --cut-lg: 0.65rem;

    :global(.shard__body) {
      justify-content: center;
    }
  }

  .tile__group {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    line-height: 1.2;
    color: hsl(22 34% 24%);
  }

  // One authored moment: the wall is set, then the light runs across the glaze.
  // Default state is the finished wall, so no script and no motion means no loss.
  .tile :global(.shard__face) {
    overflow: hidden;
  }

  .tile :global(.shard__face)::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(104deg, transparent 34%, hsl(0 0% 100% / 0.32) 50%, transparent 66%);
    pointer-events: none;
  }

  :global(html.tc-motion) .mosaic:not(.is-set) .tile {
    opacity: 0.68;
    transform: translateY(6px);
  }

  :global(html.tc-motion) .mosaic .tile {
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 12ms),
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 12ms);
  }

  :global(html.tc-motion) .mosaic.is-set .tile :global(.shard__face)::after {
    animation: glint 1100ms cubic-bezier(0.22, 1, 0.36, 1) calc(160ms + var(--i) * 19ms) both;
  }

  @keyframes glint {
    0% {
      opacity: 0;
      transform: translateX(-130%);
    }
    22% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(130%);
    }
  }
</style>
