---
import Layout from "@/layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Oops, this's an unpleasant place" description="There was a typo maybe? Not found page">
  <section class="not-found">
    <div class="sg-wrap">
      <h1 class="code">404</h1>
      <p class="msg">Whoops, we&rsquo;ve been lost for some time</p>
      <p class="but sg-label">but</p>
      <a class="way" href={baseUrl} aria-label="Go to home page">This is the way</a>
    </div>
  </section>
</Layout>

<style lang="scss">
  .not-found {
    display: grid;
    place-content: center;
    place-items: center;
    text-align: center;
    min-height: 60vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .sg-wrap {
    display: grid;
    place-items: center;
    gap: 0.75rem;
  }

  .code {
    font-family: var(--dot);
    font-weight: 600;
    font-size: var(--t-display);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--ink-0);
    margin: 0;
  }

  .msg {
    font-size: var(--t-lead);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink-1);
    max-width: 26ch;
  }

  .but {
    margin-top: 0.5rem;
  }

  .way {
    position: relative;
    padding: 0 0.25rem 0.4rem;
    font-size: var(--t-title);
    color: var(--ink-1);
    text-decoration: none;
  }

  .way::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--rule-strong);
    transform: scaleX(1);
    transform-origin: right;
  }

  .way:hover {
    color: var(--ink-0);
  }

  .way:hover::after {
    background: var(--accent);
  }
</style>
