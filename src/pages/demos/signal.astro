---
import "../../styles/demos/signal/base.scss";
import doto from "../../styles/demos/signal/fonts/doto-latin-var.woff2";
import grotesk from "../../styles/demos/signal/fonts/space-grotesk-latin-var.woff2";
import mono400 from "../../styles/demos/signal/fonts/space-mono-latin-400.woff2";
import mono700 from "../../styles/demos/signal/fonts/space-mono-latin-700.woff2";
import { identity, seo } from "../../data/profile";
import Rail from "../../components/demos/signal/Rail.astro";
import Identity from "../../components/demos/signal/Identity.astro";
import Stack from "../../components/demos/signal/Stack.astro";
import Repos from "../../components/demos/signal/Repos.astro";
import Contact from "../../components/demos/signal/Contact.astro";
import ActionBar from "../../components/demos/signal/ActionBar.astro";

const title = `${identity.fullName} — ${identity.role}`;
const fonts = [doto, grotesk, mono400, mono700];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={seo.description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f2f0" media="(prefers-color-scheme: light)" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      fonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }
  </head>
  <body>
    <a class="sg-skip" href="#identity">Skip to content</a>
    <div class="sg-rules" aria-hidden="true">
      <div>
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="sg-page">
      <Rail />
      <main>
        <Identity />
        <Stack />
        <Repos />
        <Contact />
      </main>
    </div>
    <ActionBar />
  </body>
</html>
