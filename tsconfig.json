{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "paths": {
      "@/signal/*": ["./src/components/signal/*"],
      "@/layouts/*": ["./src/layouts/*"]
    }
  }
}
